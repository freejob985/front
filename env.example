# ===========================================
# Environment Variables Example File
# ===========================================
# Copy this file to .env and modify values as needed

# ===========================================
# Basic Application Settings
# ===========================================
# Application name - appears in title and logo
VITE_APP_NAME="Engeb"

# Main website URL - used in links and references
VITE_APP_URL=https://eliteonegrocery.com

# ===========================================
# Backend API Settings
# ===========================================
# Base API server URL (without /api/v1)
VITE_API_BASE_URL=https://adminxd.eliteonegrocery.com

# API prefix - added to requests
VITE_API_PREFIX=/api/v1

# Complete API URL - used in requests
VITE_API_URL=https://adminxd.eliteonegrocery.com/api/v1

# ===========================================
# Admin Panel Settings
# ===========================================
# Admin panel URL - used to access site management
VITE_ADMIN_URL=https://adminxd.eliteonegrocery.com/admin

# ===========================================
# Proxy Settings (Request Forwarding)
# ===========================================
# Target for API request forwarding
# This variable controls where requests are sent from local proxy
VITE_API_TARGET=https://adminxd.eliteonegrocery.com

# Target for admin request forwarding
VITE_ADMIN_TARGET=https://adminxd.eliteonegrocery.com

# ===========================================
# Development Settings
# ===========================================
# Enable debug mode - shows detailed messages in console
VITE_DEBUG=true

# Application environment - development or production
VITE_APP_ENV=development

# ===========================================
# API Mode Control - CRITICAL FOR CORS FIX
# ===========================================
# Controls how the application handles API requests
# Available values:
#   - 'proxy': use local proxy (default for development)
#     * sends requests to http://localhost:5174/api/v1
#     * proxy forwards them to real server
#     * avoids CORS issues
#     * RECOMMENDED for development
#   - 'direct': direct API connection
#     * sends requests directly to https://adminxd.eliteonegrocery.com/api/v1
#     * requires CORS setup on server
#     * suitable for production and testing
#     * REQUIRES CORS configuration on backend server
VITE_API_MODE=proxy

# ===========================================
# Production Settings (uncomment when deploying)
# ===========================================
# VITE_API_TARGET=https://your-production-api.com
# VITE_ADMIN_TARGET=https://your-production-admin.com
# VITE_API_URL=https://your-production-api.com/api/v1
# VITE_ADMIN_URL=https://your-production-admin.com/admin
# VITE_API_MODE=direct
# VITE_DEBUG=false
# VITE_APP_ENV=production
